# ========================================
# Data Ingestion Service - Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ========================================
# API Server
# ========================================
API_HOST=0.0.0.0
API_PORT=8002

# ========================================
# Database (Required)
# ========================================
# PostgreSQL connection string using asyncpg driver
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/data_ingestion

# ========================================
# Tenant Service
# ========================================
# Base URL for the tenant service (for fetching secrets)
TENANT_SERVICE_URL=http://localhost:8008

# ========================================
# AWS / Message Queue
# ========================================
# SQS queue URL for publishing normalized messages
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/your-queue-name
AWS_REGION=us-east-1

# ========================================
# Workers Configuration
# ========================================
# Polling interval for workers in seconds (default 900 = 15 minutes)
WORKER_POLL_INTERVAL=900

# ========================================
# Logging
# ========================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
